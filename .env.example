# ---- Site Origin ----
# In production on Vercel set: https://theburnoutwheels-vert.vercel.app
NEXT_PUBLIC_SITE_URL=https://theburnoutwheels-vert.vercel.app

# ---- Security Secret ----
# Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# ---- Admin Seed Credentials ----
ADMIN_EMAIL=theburnoutwheels@gmail.com
ADMIN_PASSWORD=change-me-to-a-strong-pass

# ---- Google OAuth 2.0 Credentials ----
# Obtain from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# Authorized JavaScript origin: https://theburnoutwheels-vert.vercel.app (and http://localhost:3000)
# Authorized redirect URI: https://theburnoutwheels-vert.vercel.app/api/auth/google/callback (and http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---- SMTP / Email Delivery (For real OTP codes & verification emails) ----
# For Gmail, use an App Password from Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=theburnoutwheels@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SMTP_FROM=Burnout Wheels <theburnoutwheels@gmail.com>

# ---- Discord Notifications (optional but recommended) ----
# Create a Webhook in Discord Server -> Channel Settings -> Integrations -> Webhooks
# New checkout orders will automatically post directly into your Discord channel!
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Optional: send full order alerts to a dedicated orders channel. When empty the
# app falls back to DISCORD_WEBHOOK_URL above.
DISCORD_ORDERS_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ---- Durable Order + Catalog Store (Vercel Blob, private) ----
# Vercel adds BLOB_STORE_ID (and an OIDC token) automatically when you connect a
# PRIVATE Blob store to this project. Do not use a public store: order snapshots
# contain customer names, emails, and delivery addresses. The same store also
# holds the live product catalog and admin-uploaded product photos.
# For local development, run `vercel env pull` or set ORDER_STORE_DIR to use a
# local folder instead:
# BLOB_STORE_ID=store_...
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# ORDER_STORE_DIR=./data/order-store
# CATALOG_STORE_DIR=./data/catalog-store

